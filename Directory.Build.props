<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <NoWarn>$(NoWarn);NU1901;NU1902;NU1903;NU1904;NU1905</NoWarn>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904;NU1905</WarningsNotAsErrors>
    <NuGetAudit>false</NuGetAudit>
    <Deterministic>true</Deterministic>

    <!-- Base Semantic Version -->
    <BaseVersion>0.2.0</BaseVersion>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
  </PropertyGroup>

  <!-- Debug Configuration: Appends dynamic build timestamp (e.g. 0.1.0.826) -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <Version>$(BaseVersion).$([System.DateTime]::Now.ToString("MMdd"))</Version>
    <AssemblyVersion>$(BaseVersion).$([System.DateTime]::Now.ToString("MMdd"))</AssemblyVersion>
    <FileVersion>$(BaseVersion).$([System.DateTime]::Now.ToString("MMdd"))</FileVersion>
    <InformationalVersion>$(BaseVersion)-debug+$([System.DateTime]::Now.ToString("yyyyMMddHHmmss"))</InformationalVersion>
  </PropertyGroup>

  <!-- Release Configuration: Clean semantic version without build suffix -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Version>$(BaseVersion)</Version>
    <AssemblyVersion>$(BaseVersion).0</AssemblyVersion>
    <FileVersion>$(BaseVersion).0</FileVersion>
    <InformationalVersion>$(BaseVersion)</InformationalVersion>
  </PropertyGroup>
</Project>