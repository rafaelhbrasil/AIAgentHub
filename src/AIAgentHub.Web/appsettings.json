{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "AIAgentHub.Infrastructure.Providers.PromptLogger": "Information"
    },
    "File": {
      "Enabled": true,
      "Path": "logs/app-{Date}.log"
    },
    "PromptLogging": true
  },
  "AllowedHosts": "*",
  "AgentHub": {
    "OpenBrowserAtStartup": true,
    "CliExecution": {
      "Headless": true,
      "Shell": "PowerShell",
      "HeadedAutoCloseDelaySeconds": 10,
      "TimeoutMinutes": 10,
      "HeartbeatIntervalSeconds": 60,
      "AutoResumeOnTimeout": true,
      "MaxAutoResumes": 2
    }
  },
  "ProviderSwitchSettings": {
    "RecentMessageCounts": [10, 20, 50]
  }
}
