{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "AIAgentHub.Infrastructure.Providers.PromptLogger": "Debug"
    }
  },
  "AllowedHosts": "*",
  "AgentHub": {
    "OpenBrowserAtStartup": true,
    "CliExecution": {
      "Headless": true,
      "Shell": "PowerShell",
      "HeadedAutoCloseDelaySeconds": 10,
      "TimeoutMinutes": 10,
      "HeartbeatIntervalSeconds": 60,
      "AutoResumeOnTimeout": true,
      "MaxAutoResumes": 2
    },
    "PromptLogging": false
  }
}
