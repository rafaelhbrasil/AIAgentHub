{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "AIAgentHub.Infrastructure.Providers.PromptLogger": "Debug"
    }
  },
  "AllowedHosts": "*",
  "AgentHub": {
    "CliExecution": {
      "Headless": true,
      "Shell": "PowerShell",
      "HeadedAutoCloseDelaySeconds": 10
    },
    "PromptLogging": {
      "Enabled": true
    }
  }
}
